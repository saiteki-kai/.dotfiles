### Autostart applications

# Set environment variables for Wayland applications
exec systemctl --user set-environment XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment DISPLAY SWAYSOCK WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway WAYLAND_DISPLAY

# Start background services
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec foot --server

# Startup applications on specific workspaces
exec swaymsg "workspace 1; exec --no-startup-id brave;"
exec swaymsg "workspace 2; exec --no-startup-id $term;"
