
### Variables

# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $term footclient
set $menu rofi -show drun
set $logout wlogout -b 5 -T 425 -B 455 -L 300 -R 300 -c 20 -s -p layer-shell
set $lockscreen hyprlock # swaylock -f -c 000000

set $wallpaper ~/Pictures/wallpapers/wallhaven-5785m3_1920x1080.png 

font pango:JetBrainsMono Nerd Font 10

### Output configuration

# Setup with external monitor on top of laptop screen (eDP-1).
# You can get the names of your outputs by running: swaymsg -t get_outputs

output eDP-1 {
    bg $wallpaper fill
    mode 1920x1080@144Hz
    pos 0 0
}

# output HDMI-A-2 {
#     bg $wallpaper fill
#     # mode 1920x1080@144Hz
#     pos 0 -1080
# }

output HDMI-A-2 {
    bg $wallpaper fill
    mode 2560x1440@70Hz
    pos 0 -1440
}

# Blurred wallpaper for lock screen and logout menu

exec_always magick $wallpaper -blur 0x8 /tmp/wallpaper_blurred.png

### Idle configuration

# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 60 seconds, and turn your screens back on when
# resumed. After 900 seconds of inactivity, it will suspend your computer.
# It will also lock your screen before your computer goes to sleep.

# bindswitch --locked lid:toggle exec swaylock --daemonize && systemctl sleep

exec swayidle -w \
     timeout 300 '$lockscreen' \
     timeout 360 'swaymsg "output * power off"'\
     resume      'swaymsg "output * power on"'

